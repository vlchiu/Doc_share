# Copy to backend/.env for a new installation only. Preserve existing settings.
DATABASE_URL=postgresql://postgres:password@localhost:5432/docshare
JWT_SECRET=
PORT=5000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:5173

# Google OAuth: register this callback in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail SMTP: use credentials accepted by Gmail, typically an App Password.
# Never commit credentials or use a public VITE_ variable for them.
EMAIL_USER=
EMAIL_PASS=

# SePay is the supported payment provider. MoMo/VNPay routes are disabled.
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_KEY=
FREE_DOWNLOAD_LIMIT=10

TAVILY_API_KEY=
# Reuse the Gemini key already used by AI Chat.
GEMINI_API_KEY=
# Web Search only; choose a model available to your Gemini project.
# Default matches AI Chat's current first-choice model.
GEMINI_WEB_SEARCH_MODEL=gemini-3.5-flash-lite

# Optional fallback for existing AI Chat only; Web Search does not use Groq.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Account quotas: deploy migration before enabling. 0 = unlimited.
ACCOUNT_QUOTAS_ENABLED=false
FREE_AI_DAILY_LIMIT=0
VIP_AI_DAILY_LIMIT=0
FREE_STORAGE_MB=0
VIP_STORAGE_MB=0
