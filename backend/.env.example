# Merge into backend/.env; preserve existing database/auth settings.
TAVILY_API_KEY=
# Reuse the Gemini key already used by AI Chat.
GEMINI_API_KEY=
# Web Search only; choose a model available to your Gemini project.
# Default matches AI Chat's current first-choice model.
GEMINI_WEB_SEARCH_MODEL=gemini-3.5-flash-lite

# Optional fallback for existing AI Chat only; Web Search does not use Groq.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
